<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LotroPresence</AssemblyName>
    <RootNamespace>LotroPresence.Bridge</RootNamespace>
    <Version>0.4.16</Version>
    <AssemblyVersion>0.4.16.0</AssemblyVersion>
    <FileVersion>0.4.16.0</FileVersion>
    <InformationalVersion>0.4.16-alpha</InformationalVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.default.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LotroPresence.Tests" />
  </ItemGroup>

</Project>
